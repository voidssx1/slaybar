{
  "layer": "top",
  "position": "left",
  "orientation": "vertical",
  "width": 62,
  "spacing": 8,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "exclusive": true,
  "fixed-center": true,
  "modules-left": [
    "niri/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "cpu",
    "memory",
    "battery"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "current-only": true,
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "default": "一"
    }
  },
  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "network": {
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-disconnected": " ",
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "bluetooth": {
    "format": "",
    "format-connected": "",
    "format-disabled": "",
    "format-off": ""
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "Muted"
  },
  "backlight": {
    "format": "{percent}%"
  },
  "cpu": {
    "format": "{usage}%"
  },
  "memory": {
    "format": "{percentage}%"
  },
  "battery": {
    "tooltip": false,
    "format": "{capacity}%",
    "format-charging": "{capacity}%",
    "format-plugged": "{capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-discharging": "{capacity}%",
    "format-full": "{capacity}%"
  }
}
